# Server
PORT=8000
LOG_LEVEL=info

# Security
INGEST_SECRET=some_shared_hmac_secret

# Slack
SLACK_BOT_TOKEN=xoxb-
SLACK_DEFAULT_CHANNEL=

# Notion
NOTION_API_KEY=secret_...

# OpenAI (optional for embeddings + tone)
OPENAI_API_KEY=sk-....
CHAOS_MODEL=gpt-4o-mini

# Chroma server (preferred)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
DISABLE_INGEST_SIGNATURE=true
DISABLE_SLACK_VERIFY=true
